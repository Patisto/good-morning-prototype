# Runtime app credentials. Keep the real file on the VPS, outside the repository.
DATABASE_URL=postgres://good_morning_app:APP_PASSWORD@127.0.0.1:5432/good_morning
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_EXPIRES_IN=12h
PORT=4000
FRONTEND_URL=https://www.goodmorningmw.online,https://goodmorningmw.online
SALE_ERASE_KEY=SET_A_PRIVATE_RANDOM_KEY_ON_THE_SERVER
# PayChangu environment: test or live.
PAYCHANGU_ENV=test
# PayChangu API base URL; normally https://api.paychangu.com.
PAYCHANGU_BASE_URL=https://api.paychangu.com
# Server-only PayChangu secret key; never expose it to the browser.
PAYCHANGU_SECRET_KEY=
# Public key is reserved for a future client-side checkout mode.
PAYCHANGU_PUBLIC_KEY=
# Webhook HMAC secret from the PayChangu dashboard.
PAYCHANGU_WEBHOOK_SECRET=
# Public HTTPS webhook endpoint configured in PayChangu.
PAYCHANGU_CALLBACK_URL=https://api.example.com/api/webhooks/paychangu
# Public payment-page return URL; the backend appends ?ref=.
PAYCHANGU_RETURN_URL=https://payments.example.com/
# Optional cancellation/return URL if enabled by the merchant account.
PAYCHANGU_CANCEL_URL=
# Currency charged by the rental ledger.
PAYMENT_CURRENCY=MWK
# Whether a student may pay less than the current outstanding balance.
ALLOW_PARTIAL_PAYMENTS=true
# Smallest permitted payment amount in ledger currency.
MIN_PAYMENT_AMOUNT=0
# Whether payments greater than the balance are accepted.
ALLOW_OVERPAYMENT=false
# Secret used to sign short-lived lookup tokens.
LOOKUP_TOKEN_SECRET=
# Lookup token lifetime in seconds.
LOOKUP_TOKEN_TTL_SECONDS=600
# Pending payment lifetime in minutes.
PAYMENT_PENDING_EXPIRY_MINUTES=60
# Reconciliation scheduler interval in minutes.
RECONCILE_INTERVAL_MINUTES=10
# Public origin of the static payment site.
FRONTEND_URL=
# Comma-separated allowed browser origins; restrict this to the payment site.
CORS_ALLOWED_ORIGINS=
# Lookup requests allowed per IP/phone per minute.
RATE_LIMIT_LOOKUP_PER_MINUTE=5
# Payment initiation requests allowed per IP per minute.
RATE_LIMIT_INITIATE_PER_MINUTE=5
# Payment status requests allowed per IP per minute.
RATE_LIMIT_STATUS_PER_MINUTE=30
# Canonical application URL.
APP_URL=
