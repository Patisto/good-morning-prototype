# Copy this file to .env and adjust as needed.

# When running via `docker compose up`, host "db" resolves to the postgres container.
# When running the API locally against `docker compose up db`, use host "localhost".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/good_morning

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

PORT=4000

# Origin of the Vue dev server, for CORS.
FRONTEND_URL=http://localhost:5173
