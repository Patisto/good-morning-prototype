# Runtime app credentials. Keep the real file on the VPS, outside the repository.
DATABASE_URL=postgres://good_morning_app:APP_PASSWORD@127.0.0.1:5432/good_morning
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_EXPIRES_IN=12h
PORT=4000
FRONTEND_URL=https://www.goodmorningmw.online,https://goodmorningmw.online
API_PUBLIC_URL=https://YOUR_API_HOST
PAYCHANGU_SECRET_KEY=SET_FROM_PAYCHANGU_DASHBOARD
PAYCHANGU_WEBHOOK_SECRET=SET_FROM_PAYCHANGU_DASHBOARD
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASSWORD=SET_FROM_EMAIL_PROVIDER
SMTP_FROM=Good Morning Hostel <bookings@example.com>
SALE_ERASE_KEY=SET_A_PRIVATE_RANDOM_KEY_ON_THE_SERVER
